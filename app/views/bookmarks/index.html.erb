<div class="container mt-4">
  <h2 class="mb-4">My Bookmarked Recipes</h2>

  <% if @recipes.present? && @recipes.any? %>
    <div class="row">
      <% @recipes.each do |recipe| %>
        <div class="col-md-4 mb-4">
          <div class="card shadow-sm p-3 h-100">
            <h5><%= recipe.title %></h5>

            <% if recipe.images.attached? %>
              <div class="d-flex flex-wrap gap-1 mb-2">
                <% recipe.images.each do |img| %>
                  <div style="width: 80px; height: 80px; overflow: hidden;">
                    <%= image_tag img.variant(resize_to_limit: [80, 80]).processed, class: "rounded" %>
                  </div>
                <% end %>
              </div>
            <% end %>

            <p>Cooking Time: <%= recipe.cooking_time %> mins</p>
            <% if recipe.instructions.present? %>
              <p><strong>Instructions:</strong> <%= truncate(recipe.instructions, length: 50) %></p>
            <% end %>

            <div class="d-flex gap-1 mt-2">
              <%= link_to "View", recipe_path(recipe), class: "btn btn-primary btn-sm" %>
              <%= button_to "Remove Bookmark", recipe_bookmark_path(recipe), method: :delete, class: "btn btn-warning btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">You have no bookmarked recipes yet.</p>
  <% end %>
</div>
