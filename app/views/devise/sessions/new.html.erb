<h2 class="text-center mb-4">Log in</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name),
             html: { class: "card p-4 shadow-sm mx-auto", style: "max-width: 400px;" }) do |f| %>

  <div class="mb-3">
    <%= f.label :username, class: "form-label" %>
    <%= f.text_field :username, autofocus: true, class: "form-control", autocomplete: "username" %>
  </div>

  <div class="mb-3">
    <%= f.label :password, class: "form-label" %>
    <%= f.password_field :password, class: "form-control", autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="form-check mb-3">
      <%= f.check_box :remember_me, class: "form-check-input" %>
      <%= f.label :remember_me, class: "form-check-label" %>
    </div>
  <% end %>

  <div class="d-grid">
    <%= f.submit "Log in", class: "btn btn-primary" %>
  </div>
<% end %>

<div class="text-center mt-3">
  <%= render "devise/shared/links" %>
</div>
