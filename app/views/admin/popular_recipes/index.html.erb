<!-- app/views/admin/popular_recipes/index.html.erb -->

<h1>Popular Recipes</h1>

<table class="table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Likes</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @popular_recipes.each do |recipe| %>
      <tr>
        <td><%= recipe.title %></td>
        <td><%= recipe.likes.count %></td>
        <td>
          <%= link_to "View", admin_popular_recipe_path(recipe), class: "btn btn-sm btn-primary" %>
          <%= link_to "Edit", edit_admin_popular_recipe_path(recipe), class: "btn btn-sm btn-warning" %>
          <%= link_to "Delete", admin_popular_recipe_path(recipe),
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                      class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<!-- JavaScript (put this in app/javascript/application.js in Rails 7 with importmap or webpacker) -->
<script type="module">
  import "@hotwired/turbo-rails"

  // This ensures Turbo is active and can handle link_to with turbo_method
  document.addEventListener("DOMContentLoaded", () => {
    console.log("✅ Turbo is running and Delete buttons will work with turbo_method: :delete");
  });
</script>
