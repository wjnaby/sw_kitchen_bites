<h1>Edit Recipe: <%= @recipe.title %></h1>
<%= form_with model: [:admin, @recipe], local: true do |f| %>
  <div class="mb-3">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :description %>
    <%= f.text_area :description, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :ingredients %>
    <%= f.text_area :ingredients, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :instructions %>
    <%= f.text_area :instructions, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :image %>
    <%= f.file_field :image, class: "form-control" %>
  </div>
  <%= f.submit "Update Recipe", class: "btn btn-primary" %>
  <%= link_to "Cancel", admin_popular_recipes_path, class: "btn btn-secondary ms-2" %>
<% end %>
