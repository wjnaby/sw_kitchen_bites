<h1>Active Users</h1>
<table class="table">
  <thead>
    <tr>
      <th>Username</th>
      <th>Recipes</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @active_users.each do |user| %>
      <tr>
        <td><%= user.username %></td>
        <td><%= user.recipes.count %></td>
        <td>
          <%= link_to "View", admin_active_user_path(user), class: "btn btn-sm btn-primary" %>
          <%= link_to "Edit", edit_admin_active_user_path(user), class: "btn btn-sm btn-warning" %>
          <%= link_to "Delete", admin_active_user_path(user), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
