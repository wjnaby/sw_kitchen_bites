<h1>User Details: <%= @user.username %></h1>

<div class="mb-3">
  <strong>Username:</strong> <%= @user.username %>
</div>

<div class="mb-3">
  <strong>Email:</strong> <%= @user.email %>
</div>

<div class="mb-3">
  <strong>Role:</strong> <%= @user.role %>
</div>

<div class="mb-3">
  <strong>Bio:</strong> <%= @user.bio %>
</div>

<div class="mb-3">
  <strong>Avatar:</strong><br>
  <% if @user.avatar.attached? %>
    <%= image_tag @user.avatar, class: "rounded-circle", style: "width: 150px; height: 150px; object-fit: cover;" %>
  <% else %>
    <p>No avatar uploaded.</p>
  <% end %>
</div>

<div class="mb-3">
  <strong>Recipes Count:</strong> <%= @user.recipes.count %>
</div>

<%= link_to "Edit User", edit_admin_active_user_path(@user), class: "btn btn-warning" %>
<%= link_to "Back to Active Users", admin_active_users_path, class: "btn btn-secondary ms-2" %>
<%= link_to "Delete User", admin_active_user_path(@user), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger ms-2" %>
