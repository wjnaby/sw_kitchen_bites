<h1><%= @recipe.title %></h1>
<p><strong>Description:</strong> <%= @recipe.description %></p>
<p><strong>Ingredients:</strong> <%= @recipe.ingredients %></p>
<p><strong>Instructions:</strong> <%= @recipe.instructions %></p>
<p><strong>Reported By:</strong> <%= @recipe.reports.last.user.username if @recipe.reports.any? %></p>
<%= link_to "Back to Reported Recipes", admin_reported_recipes_path, class: "btn btn-secondary" %>
