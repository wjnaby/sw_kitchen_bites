<table class="table table-striped">
  <thead>
    <tr>
      <th>#</th>
      <th>Title</th>
      <th>Author</th>
      <th>Created At</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @recipes.each_with_index do |recipe, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= recipe.title %></td>
        <td><%= recipe.user.username %></td>
        <td><%= recipe.created_at.strftime("%d %b %Y") %></td>
        <td>
          <%= link_to "View", admin_view_recipe_path(recipe), class: "btn btn-sm btn-primary" %>
          <%= link_to "Delete", admin_destroy_recipe_path(recipe), method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Are you sure you want to delete this recipe?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
