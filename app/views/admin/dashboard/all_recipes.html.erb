<table class="table table-striped text-center align-middle shadow-sm">
  <thead class="table-dark">
    <tr>
      <th>#</th>
      <th>Title</th>
      <th>Author</th>
      <th>Created At</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @recipes.each_with_index do |recipe, index| %>
      <tr>
        <!-- Correct numbering across pages -->
        <td><%= index + 1 + ((@recipes.current_page - 1) * @recipes.limit_value) %></td>
        <td><%= recipe.title %></td>
        <td><%= recipe.user&.username || "Unknown" %></td>
        <td><%= recipe.created_at.strftime("%d %b %Y") %></td>
        <td>
          <!-- View button -->
          <%= link_to "View",
              admin_view_recipe_path(recipe),
              class: "btn btn-sm btn-primary" %>

          <!-- Delete button -->
          <%= button_to "Delete",
              admin_destroy_recipe_path(recipe),
              method: :delete,
              form: { data: { turbo: false } },
              class: "btn btn-sm btn-danger",
              data: { confirm: "Are you sure you want to delete this recipe?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<!-- Pagination links -->
<div class="d-flex justify-content-center mt-4">
<%= paginate @recipes %>
</div>
