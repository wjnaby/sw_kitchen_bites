<div class="container mt-4">
  <h1 class="mb-4">📊 Admin Dashboard</h1>

  <!-- Stats Cards -->
  <div class="row">
    <div class="col-md-4 mb-3">
      <div class="card text-center shadow-sm border-primary">
        <div class="card-body">
          <h5 class="card-title text-primary">👥 Users</h5>
          <h2><%= @users_count %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card text-center shadow-sm border-success">
        <div class="card-body">
          <h5 class="card-title text-success">📖 Recipes</h5>
          <h2><%= @recipes_count %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card text-center shadow-sm border-danger">
        <div class="card-body">
          <h5 class="card-title text-danger">🚨 Reports</h5>
          <h2><%= @reports_count %></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <h3 class="mt-4">⚡ Quick Links</h3>
  <div class="d-flex gap-2 flex-wrap mb-4">
    <%= link_to "All Users", admin_all_users_path, class: "btn btn-outline-primary" %>
    <%= link_to "All Recipes", admin_all_recipes_path, class: "btn btn-outline-success" %>
    <%= link_to "Reports", admin_reported_recipes_path, class: "btn btn-outline-danger" %>
  </div>
</div>
