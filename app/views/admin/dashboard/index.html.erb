<div class="container mt-4">
  <h1 class="mb-4">📊 Admin Dashboard</h1>

  <!-- Stats Cards -->
  <div class="row">
    <div class="col-md-4 mb-3">
      <div class="card text-center shadow-sm border-primary">
        <div class="card-body">
          <h5 class="card-title text-primary">👥 Users</h5>
          <h2><%= @users_count %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card text-center shadow-sm border-success">
        <div class="card-body">
          <h5 class="card-title text-success">📖 Recipes</h5>
          <h2><%= @recipes_count %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card text-center shadow-sm border-danger">
        <div class="card-body">
          <h5 class="card-title text-danger">🚨 Reports</h5>
          <h2><%= @reports_count %></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <h3 class="mt-4">⚡ Quick Links</h3>
  <div class="d-flex gap-2 flex-wrap mb-4">
    <%= link_to "All Users", admin_all_users_path, class: "btn btn-outline-primary" %>
    <%= link_to "All Recipes", admin_all_recipes_path, class: "btn btn-outline-success" %>
    <%= link_to "Reports", admin_reported_recipes_path, class: "btn btn-outline-danger" %>
  </div>

  <!-- Charts -->
  <h3 class="mt-5">📈 Analytics</h3>
  <canvas id="dashboardChart" height="100"></canvas>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const ctx = document.getElementById('dashboardChart').getContext('2d');
      const chart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Users', 'Recipes', 'Reports'],
          datasets: [{
            label: 'Count',
            data: [<%= @users_count %>, <%= @recipes_count %>, <%= @reports_count %>],
            backgroundColor: ['#0d6efd', '#198754', '#dc3545']
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: { beginAtZero: true, precision:0 }
          }
        }
      });
    });
  </script>

  <!-- Most Active Users -->
  <h3 class="mt-5">🔥 Most Active Users</h3>
  <ul class="list-group mb-4">
    <% @most_active_users.each do |user| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <%= user.username %>
        <span class="badge bg-primary rounded-pill"><%= user.recipes_count %> recipes</span>
      </li>
    <% end %>
  </ul>

  <!-- Most Liked Recipes -->
  <h3 class="mt-5">❤️ Most Liked Recipes</h3>
  <ul class="list-group mb-4">
    <% @most_liked_recipes.each do |recipe| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <%= recipe.title %> by <%= recipe.user&.username || "Unknown" %>
        <span class="badge bg-success rounded-pill"><%= recipe.likes_count %> likes</span>
      </li>
    <% end %>
  </ul>
</div>
