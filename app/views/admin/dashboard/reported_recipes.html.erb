<div class="container mt-4">
  <h1>🚨 Reported Recipes</h1>
  <table class="table table-striped table-hover mt-3">
    <thead class="table-light">
      <tr>
        <th>Recipe</th>
        <th>Author</th>
        <th>Reports</th>
      </tr>
    </thead>
    <tbody>
      <% @reported_recipes.each do |r| %>
        <tr>
          <td><%= r.title %></td>
          <td><%= r.user.username %></td>
          <td><%= r.reports.count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
