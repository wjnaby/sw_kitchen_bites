<!-- app/views/admin/dashboard/view_recipe.html.erb -->

<div class="container mt-5">
  <h2 class="mb-4 text-center">Recipe Details (Admin)</h2>

  <div class="card shadow-sm p-4">
    <h4><%= @recipe.title %></h4>
    <p><strong>By:</strong> <%= @recipe.user.username if @recipe.user %></p>
    <p><strong>Cooking Time:</strong> <%= @recipe.cooking_time %> mins</p>

    <% if @recipe.images.attached? %>
      <div class="d-flex flex-wrap gap-1 mb-3">
        <% @recipe.images.each do |img| %>
          <div style="width: 100px; height: 100px; overflow: hidden;">
            <%= image_tag img.variant(resize_to_limit: [100, 100]).processed, class: "rounded" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @recipe.instructions.present? %>
      <div class="mb-3">
        <h5>Instructions</h5>
        <p><%= simple_format(@recipe.instructions) %></p>
      </div>
    <% end %>

    <% if @recipe.ingredients.present? %>
      <div class="mb-3">
        <h5>Ingredients</h5>
        <p><%= simple_format(@recipe.ingredients) %></p>
      </div>
    <% end %>

    <div class="d-flex justify-content-end gap-2 mt-4">
      <%= link_to "Back to All Recipes", admin_all_recipes_path, class: "btn btn-secondary" %>
      <%= link_to "Delete Recipe", admin_destroy_recipe_path(@recipe.id),
                  method: :delete,
                  data: { confirm: "Are you sure you want to delete this recipe?" },
                  class: "btn btn-danger" %>
    </div>
  </div>
</div>
