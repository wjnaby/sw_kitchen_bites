<h2 class="mb-4 text-center">All Users</h2>

<table class="table table-striped text-center align-middle shadow-sm">
  <thead class="table-dark">
    <tr>
      <th>#</th>
      <th>Username</th>
      <th>Email</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each_with_index do |user, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td>
          <% if user.active %>
            <%= button_to "Active",
                admin_toggle_user_active_path(user),
                method: :patch,
                class: "btn btn-sm btn-success",
                data: { confirm: "Deactivate this user?", turbo: false } %>
          <% else %>
            <%= button_to "Inactive",
                admin_toggle_user_active_path(user),
                method: :patch,
                class: "btn btn-sm btn-warning",
                data: { confirm: "Activate this user?", turbo: false } %>
          <% end %>
        </td>
        <td>
          <%= button_to "Delete",
              admin_destroy_user_path(user),
              method: :delete,
              class: "btn btn-sm btn-danger",
              data: { confirm: "Are you sure you want to delete this user?", turbo: false } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
