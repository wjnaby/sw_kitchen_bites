<table class="table table-striped">
  <thead>
    <tr>
      <th>#</th>
      <th>Username</th>
      <th>Email</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each_with_index do |user, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td>
          <% if user.active %>
            <span class="badge bg-success">Active</span>
          <% else %>
            <span class="badge bg-danger">Inactive</span>
          <% end %>
        </td>
        <td>
          <%= link_to "Delete", admin_destroy_user_path(user), method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Are you sure you want to delete?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
