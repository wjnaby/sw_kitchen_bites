<div class="container mt-4">
  <h2>Notifications</h2>

  <% if @notifications.any? %>
    <ul class="list-group">
      <% @notifications.each do |n| %>
        <li class="list-group-item d-flex justify-content-between align-items-center <%= 'fw-bold' unless n.read %>">
          <!-- Clicking the notification automatically marks it as read -->
          <%= link_to n.message, notification_path(n), class: "flex-grow-1 text-decoration-none text-dark" %>

          <div class="d-flex align-items-center gap-2">
            <small class="text-muted"><%= time_ago_in_words(n.created_at) %> ago</small>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">No notifications yet.</p>
  <% end %>
</div>
