<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 text-center">
      <!-- Avatar -->
      <% if @user.avatar.attached? %>
        <div class="mb-3">
          <%= image_tag @user.avatar.variant(resize_to_fill: [150, 150]), class: "rounded-circle shadow-sm", style: "object-fit: cover; width: 150px; height: 150px;" %>
        </div>
      <% else %>
        <div class="mb-3">
          <% if Rails.application.assets.find_asset("default_avatar.png") %>
            <%= image_tag "default_avatar.png", class: "rounded-circle shadow-sm", style: "object-fit: cover; width: 150px; height: 150px;" %>
          <% else %>
            <div class="rounded-circle shadow-sm bg-secondary" style="width: 150px; height: 150px; display: inline-block;"></div>
          <% end %>
        </div>
      <% end %>

      <!-- Username -->
      <h2><%= @user.username %></h2>

      <!-- Bio -->
      <% if @user.bio.present? %>
        <p class="text-muted"><%= @user.bio %></p>
      <% end %>

      <!-- Follow / Unfollow button -->
      <% if current_user && current_user != @user %>
        <% if current_user.following.exists?(id: @user.id) %>
          <%= button_to "Unfollow", unfollow_user_path(username: @user.username), method: :delete, class: "btn btn-outline-danger mb-3" %>
        <% else %>
          <%= button_to "Follow", follow_user_path(username: @user.username), method: :post, class: "btn btn-outline-primary mb-3" %>
        <% end %>
      <% end %>

      <!-- Followers / Following counts -->
      <p>
        <strong><%= @followers_count %></strong> Followers |
        <strong><%= @following_count %></strong> Following
      </p>

      <!-- Recipes by user -->
      <h4 class="mt-4">Recipes</h4>
      <% if @recipes.any? %>
        <div class="row">
          <% @recipes.each do |recipe| %>
            <div class="col-md-4 col-sm-6 mb-4">
              <div class="card shadow-sm h-100">
                <% if recipe.images.attached? %>
                  <%= link_to recipe_path(recipe) do %>
                    <%= image_tag recipe.images.first.variant(resize_to_fill: [400, 400]).processed, class: "card-img-top", style: "object-fit: cover; width: 100%; height: 200px;" %>
                  <% end %>
                <% else %>
                  <%= image_tag "default_recipe.png", class: "card-img-top", style: "width:100%; height:200px; object-fit: cover;" %>
                <% end %>

                <div class="card-body text-center d-flex flex-column justify-content-between" style="height: 200px;">
                  <div>
                    <h5 class="card-title"><%= link_to recipe.title, recipe_path(recipe) %></h5>

                    <!-- Caption under title -->
                    <% if recipe.caption.present? %>
                      <p class="text-muted mb-1"><em><%= truncate(recipe.caption, length: 100) %></em></p>
                    <% end %>

                    <p class="card-text text-muted">❤️ <%= recipe.likes.count %> Likes</p>
                    <p class="card-text"><%= truncate(recipe.description, length: 100) %></p>
                  </div>
                  <%= link_to "View Recipe", recipe_path(recipe), class: "btn btn-primary btn-sm mt-2" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted">No recipes yet.</p>
      <% end %>

    </div>
  </div>
</div>
