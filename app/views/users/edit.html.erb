<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
  <div class="card shadow-lg p-4" style="width: 100%; max-width: 500px; border-radius: 15px;">
    <div class="card-body">
      <h2 class="card-title text-center mb-4">Edit Profile</h2>

      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: user_path(@user.username), method: :patch, local: true, multipart: true do |f| %>
        <div class="mb-3">
          <%= f.label :username, class: "form-label fw-bold" %>
          <%= f.text_field :username, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :bio, class: "form-label fw-bold" %>
          <%= f.text_area :bio, class: "form-control", rows: 3 %>
        </div>

        <div class="mb-3">
          <%= f.label :avatar, class: "form-label fw-bold" %>
          <%= f.file_field :avatar, class: "form-control" %>

          <% if @user.avatar.attached? %>
            <div class="mt-3 text-center">
              <%= image_tag @user.avatar, class: "rounded-circle border", style: "width: 120px; height: 120px; object-fit: cover;" %>
            </div>
          <% end %>
        </div>

        <div class="d-grid mt-3">
          <%= f.submit "Update Profile", class: "btn btn-primary btn-lg" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
