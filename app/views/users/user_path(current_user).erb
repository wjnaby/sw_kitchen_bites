<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-6 text-center">
      <!-- Avatar -->
      <% if @user.avatar.attached? %>
        <div class="mb-3">
          <%= image_tag @user.avatar, class: "rounded-circle shadow-sm", style: "width: 150px; height: 150px; object-fit: cover;" %>
        </div>
      <% else %>
        <div class="mb-3">
          <%= image_tag "default_avatar.png", class: "rounded-circle shadow-sm", style: "width: 150px; height: 150px; object-fit: cover;" %>
        </div>
      <% end %>

      <!-- Username -->
      <h2 class="fw-bold"><%= @user.username %></h2>
      <p class="text-muted"><%= @user.bio.presence || "No bio yet." %></p>

      <!-- Followers / Following -->
      <div class="d-flex justify-content-center mb-3">
        <div class="px-3">
          <strong><%= @user.followers.count %></strong><br>
          <small>Followers</small>
        </div>
        <div class="px-3">
          <strong><%= @user.following.count %></strong><br>
          <small>Following</small>
        </div>
      </div>

      <!-- Buttons -->
      <% if current_user.following?(@user) %>
        <%= button_to "Unfollow", unfollow_user_path(@user.username), method: :delete, class: "btn btn-outline-danger" %>
      <% else %>
        <%= button_to "Follow", follow_user_path(@user.username), method: :post, class: "btn btn-success" %>
      <% end %>
      <% end %>
    </div>
  </div>

  <!-- Recipes Section -->
  <div class="row mt-5">
    <div class="col-12">
      <h3 class="mb-3"><%= @user.username %>’s Recipes</h3>
    </div>
    <% if @user.recipes.any? %>
      <% @user.recipes.each do |recipe| %>
        <div class="col-md-4 mb-3">
          <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
              <h5 class="card-title"><%= link_to recipe.title, recipe_path(recipe) %></h5>
              <p class="text-muted"><%= truncate(recipe.description, length: 100) %></p>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center text-muted">No recipes yet.</p>
    <% end %>
  </div>
</div>
