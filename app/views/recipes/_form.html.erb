<%= form_with model: @recipe, local: true, multipart: true do |f| %>
  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :ingredients, class: "form-label" %>
    <%= f.text_area :ingredients, rows: 4, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :instructions, class: "form-label" %>
    <%= f.text_area :instructions, rows: 4, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :cooking_time, "Cooking Time (minutes)", class: "form-label" %>
    <%= f.number_field :cooking_time, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :images, "Upload Images (max 5)", class: "form-label" %>
    <%= f.file_field :images, multiple: true, class: "form-control" %>

    <% if @recipe.images.attached? %>
      <div class="mt-3 d-flex flex-wrap gap-2">
        <% @recipe.images.each do |img| %>
          <div style="width: 100px; height: 100px; overflow: hidden;">
            <%= image_tag img.variant(resize_to_limit: [100, 100]), class: "rounded" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="d-grid mt-3">
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
