<h2>My Recipes</h2>
<%= link_to "Post New Recipe", new_recipe_path, class: "btn btn-success mb-3" %>

<div class="row">
  <% if @recipes.any? %>
    <% @recipes.each do |recipe| %>
      <div class="col-md-4 mb-3">
        <div class="card shadow-sm p-3 h-100">

          <!-- Recipe Title -->
          <h5><%= recipe.title %></h5>

          <!-- Category -->
          <% if recipe.category.present? %>
            <p class="mb-1"><strong>Category:</strong> <%= recipe.category.capitalize %></p>
          <% end %>

          <!-- Caption -->
          <% if recipe.caption.present? %>
            <p class="mb-1"><em><%= truncate(recipe.caption, length: 50) %></em></p>
          <% end %>

          <!-- Display multiple images -->
          <% if recipe.images.attached? %>
            <div class="d-flex flex-wrap gap-1 mb-2">
              <% recipe.images.each do |img| %>
                <div style="width: 80px; height: 80px; overflow: hidden;">
                  <%= image_tag img.variant(resize_to_limit: [80, 80]).processed, class: "rounded" %>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- Cooking Time -->
          <p class="mb-1">Cooking Time: <%= recipe.cooking_time %> mins</p>

          <!-- Instructions Preview -->
          <% if recipe.instructions.present? %>
            <p class="mb-1"><strong>Instructions:</strong> <%= truncate(recipe.instructions, length: 50) %></p>
          <% end %>

          <!-- Action Buttons -->
          <div class="d-flex gap-1 mt-2">
            <%= link_to "View", recipe_path(recipe), class: "btn btn-primary btn-sm" %>
            <% if recipe.user == current_user || current_user.admin? %>
              <%= link_to "Edit", edit_recipe_path(recipe), class: "btn btn-secondary btn-sm" %>
              <%= link_to "Delete", recipe_path(recipe),
                  method: :delete,
                  data: { confirm: "Are you sure?" },
                  class: "btn btn-danger btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-center text-muted">You haven't posted any recipes yet.</p>
  <% end %>
</div>

<!-- ✅ Pagination -->
<div class="d-flex justify-content-center mt-4">
  <%= paginate @recipes %>
</div>
