<div class="container mt-4">
  <div class="card shadow-sm p-4" id="recipe-card">
    <!-- Print Recipe Button -->
    <button class="btn btn-secondary mb-3" onclick="window.print()">🖨️ Print Recipe</button>

    <!-- Recipe Title -->
    <h2 class="card-title mb-2"><%= @recipe.title %></h2>

    <!-- Author -->
    <p class="d-flex align-items-center gap-2">
      <strong>By:</strong>
      <%= link_to @recipe.user.username, user_path(@recipe.user.username), class: "fw-bold" %>
    </p>

    <!-- Cooking Time -->
    <p><strong>Cooking Time:</strong> <%= @recipe.cooking_time %> minutes</p>

    <hr>

    <!-- Ingredients -->
    <h4>Ingredients</h4>
    <ul>
      <% @recipe.ingredients.to_s.split(/\r?\n/).reject(&:blank?).each do |ingredient| %>
        <li><%= ingredient.strip %></li>
      <% end %>
    </ul>

    <!-- Instructions -->
    <h4>Instructions</h4>
    <ol>
      <% @recipe.instructions.to_s.split(/\r?\n/).reject(&:blank?).each do |step| %>
        <li><%= step.strip %></li>
      <% end %>
    </ol>

    <!-- Images -->
    <% if @recipe.images.attached? %>
      <h4>Images</h4>
      <div class="d-flex flex-wrap gap-2 mt-2">
        <% @recipe.images.each_with_index do |img, index| %>
          <%= image_tag img.variant(resize_to_limit: [300, 300]).processed, class: "rounded mb-2" %>
        <% end %>
      </div>
    <% else %>
      <p>No images uploaded.</p>
    <% end %>

    <!-- Non-printable sections -->
    <div class="non-printable">
      <hr>

      <!-- Likes & Bookmarks -->
      <% if current_user %>
        <div class="mb-3 d-flex gap-2">
          <% if @recipe.likes.exists?(user: current_user) %>
            <%= button_to "❤️ Unlike (#{@recipe.likes.count})", recipe_like_path(@recipe), method: :delete, class: "btn btn-outline-danger" %>
          <% else %>
            <%= button_to "🤍 Like (#{@recipe.likes.count})", recipe_like_path(@recipe), method: :post, class: "btn btn-primary" %>
          <% end %>

          <% if current_user.bookmarked_recipes.exists?(@recipe.id) %>
            <%= button_to "🔖 Remove Bookmark", recipe_bookmark_path(@recipe), method: :delete, class: "btn btn-outline-warning" %>
          <% else %>
            <%= button_to "📑 Bookmark", recipe_bookmark_path(@recipe), method: :post, class: "btn btn-warning" %>
          <% end %>
        </div>
      <% end %>

      <!-- Share Button -->
      <button type="button" class="btn btn-info mb-3" data-bs-toggle="modal" data-bs-target="#qrModal-<%= @recipe.id %>">
        Share
      </button>

      <!-- QR Code Modal -->
      <div class="modal fade" id="qrModal-<%= @recipe.id %>" tabindex="-1" aria-labelledby="qrModalLabel-<%= @recipe.id %>" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="qrModalLabel-<%= @recipe.id %>">Share Recipe: <%= @recipe.title %></h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
              <% qr = RQRCode::QRCode.new(recipe_url(@recipe)) %>
              <%= raw qr.as_svg(module_size: 6) %>
              <p class="mt-2">Scan to view the recipe</p>

              <div class="input-group mt-2">
                <input type="text" class="form-control" id="recipe-link-<%= @recipe.id %>" value="<%= recipe_url(@recipe) %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('recipe-link-<%= @recipe.id %>').value)">Copy Link</button>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Edit / Back Buttons -->
      <div class="mt-3">
        <%= link_to "Edit", edit_recipe_path(@recipe), class: "btn btn-secondary" if @recipe.user == current_user || current_user.admin? %>
        <%= link_to "Back to Feed", feed_path, class: "btn btn-primary" %>
      </div>

      <hr>

      <!-- Comments Section -->
      <h4>Comments (<%= @recipe.comments.count %>)</h4>

      <!-- New Comment Form -->
      <% if current_user %>
        <%= form_with(model: [@recipe, Comment.new], local: true) do |f| %>
          <div class="mb-3">
            <%= f.text_area :body, class: "form-control", placeholder: "Write a comment...", rows: 3 %>
          </div>
          <%= f.submit "Post Comment", class: "btn btn-primary" %>
        <% end %>
      <% else %>
        <p class="text-muted">Log in to add a comment.</p>
      <% end %>

      <!-- Display Comments -->
      <div class="mt-3">
        <% @recipe.comments.order(created_at: :desc).each do |comment| %>
          <div class="border rounded p-2 mb-2">
            <strong><%= link_to comment.user.username, user_path(comment.user.username) %></strong>
            <small class="text-muted">• <%= time_ago_in_words(comment.created_at) %> ago</small>
            <p class="mb-1"><%= comment.body %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Print-specific CSS -->
<style>
@media print {
  #Hide everything except the recipe card */
  body * {
    visibility: hidden;
  }
  #recipe-card, #recipe-card * {
    visibility: visible;
  }

  /* Position card at top */
  #recipe-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
  }

  /* Hide non-essential elements inside the card */
  .non-printable {
    display: none !important;
  }

  /* Images resize nicely */
  img {
    max-width: 100%;
    height: auto;
  }
}
</style>
