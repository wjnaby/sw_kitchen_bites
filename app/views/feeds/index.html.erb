<style>
/* ---------------- Feed Container ---------------- */
.feed-container {
  max-width: 600px;
  margin: 0 auto;
  padding: 1rem;
}

.feed-title {
  font-size: 2rem;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 2rem;
}

/* ---------------- Feed Card ---------------- */
.feed-card {
  border: none;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  margin-bottom: 2rem;
  background: #fff;
  transition: all 0.3s ease;
}

.feed-card:hover {
  box-shadow: 0 12px 32px rgba(0,0,0,0.12);
  transform: translateY(-2px);
}

/* ---------------- User Info ---------------- */
.user-info-section {
  padding: 1rem 1.25rem 0.5rem;
}

.user-avatar {
  width: 44px;
  height: 44px;
  object-fit: cover;
  border: 2px solid #f0f0f0;
  transition: border-color 0.2s ease;
}

.user-avatar:hover {
  border-color: #667eea;
}

.username-link {
  font-weight: 600;
  font-size: 0.95rem;
  color: #1a1a1a;
  transition: color 0.2s ease;
}

.username-link:hover {
  color: #667eea;
}

/* ---------------- Recipe Title ---------------- */
.recipe-title {
  padding: 0 1.25rem;
  margin-bottom: 0.75rem;
}

.recipe-title a {
  font-size: 1.25rem;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  transition: color 0.2s ease;
}

.recipe-title a:hover {
  color: #667eea;
}

/* ---------------- Carousel ---------------- */
.carousel-wrapper {
  position: relative;
  margin-bottom: 0.75rem;
}

.carousel-inner {
  border-radius: 0;
}

.carousel-image-container {
  width: 100%;
  height: 450px;
  overflow: hidden;
  background: #f5f5f5;
}

.carousel-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.carousel-image:hover {
  transform: scale(1.02);
}

.carousel-control-prev,
.carousel-control-next {
  width: 45px;
  height: 45px;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.carousel-wrapper:hover .carousel-control-prev,
.carousel-wrapper:hover .carousel-control-next {
  opacity: 1;
}

.carousel-control-prev {
  left: 12px;
}

.carousel-control-next {
  right: 12px;
}

.carousel-control-prev-icon,
.carousel-control-next-icon {
  background-color: rgba(0,0,0,0.6);
  backdrop-filter: blur(8px);
  border-radius: 50%;
  width: 45px;
  height: 45px;
  transition: all 0.2s ease;
}

.carousel-control-prev-icon:hover,
.carousel-control-next-icon:hover {
  background-color: rgba(0,0,0,0.8);
  transform: scale(1.1);
}

/* ---------------- Caption ---------------- */
.caption {
  font-size: 0.95rem;
  color: #444;
  line-height: 1.6;
  padding: 0 1.25rem;
  margin-bottom: 1rem;
}

/* ---------------- Action Buttons ---------------- */
.actions-section {
  padding: 0 1.25rem 1rem;
}

.action-buttons-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.action-btn {
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.9rem;
  font-weight: 600;
  border: 2px solid;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.like-btn {
  border-color: #e0e0e0;
  color: #666;
  background: #fff;
}

.like-btn:hover {
  border-color: #ff6b6b;
  color: #ff6b6b;
  background: #fff5f5;
}

.like-btn.btn-outline-danger {
  border-color: #ff6b6b;
  color: #ff6b6b;
  background: #fff5f5;
}

.like-btn.btn-outline-danger:hover {
  background: #ff6b6b;
  color: #fff;
}

.bookmark-btn {
  border-color: #e0e0e0;
  color: #666;
  background: #fff;
}

.bookmark-btn:hover {
  border-color: #ffa726;
  color: #ffa726;
  background: #fff8f0;
}

.bookmark-btn.btn-outline-warning {
  border-color: #ffa726;
  color: #ffa726;
  background: #fff8f0;
}

.bookmark-btn.btn-outline-warning:hover {
  background: #ffa726;
  color: #fff;
}

.count-badge {
  font-size: 0.85rem;
  color: #666;
  font-weight: 500;
}

.comments-btn {
  border: 2px solid #e0e0e0;
  padding: 0.75rem 1.25rem;
  border-radius: 25px;
  background: #fff;
  transition: all 0.2s ease;
  font-weight: 600;
  color: #444;
}

.comments-btn:hover {
  border-color: #667eea;
  background: #f5f7ff;
  color: #667eea;
  transform: translateY(-1px);
}

.comment-badge {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 0.25rem 0.75rem;
  font-size: 0.85rem;
  font-weight: 600;
}

/* ---------------- Owner Actions ---------------- */
.owner-actions {
  margin-top: 0.75rem;
  display: flex;
  gap: 0.5rem;
}

.owner-btn {
  border-radius: 20px;
  padding: 0.5rem 1.25rem;
  font-weight: 600;
  font-size: 0.9rem;
  transition: all 0.2s ease;
}

.owner-btn:hover {
  transform: translateY(-1px);
}

.edit-btn {
  background: #667eea;
  border: none;
  color: #fff;
}

.edit-btn:hover {
  background: #5568d3;
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
}

.delete-btn {
  background: #fff;
  border: 2px solid #ff6b6b;
  color: #ff6b6b;
}

.delete-btn:hover {
  background: #ff6b6b;
  color: #fff;
  box-shadow: 0 4px 12px rgba(255, 107, 107, 0.3);
}

/* ---------------- Pagination ---------------- */
.pagination-wrapper {
  display: flex;
  justify-content: center;
  margin-top: 3rem;
  padding-bottom: 2rem;
}

.pagination {
  gap: 0.5rem;
}

.page-link {
  border-radius: 10px;
  border: 2px solid #e0e0e0;
  color: #666;
  font-weight: 600;
  transition: all 0.2s ease;
}

.page-link:hover {
  border-color: #667eea;
  background: #f5f7ff;
  color: #667eea;
}

.page-item.active .page-link {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: transparent;
}

/* ---------------- Responsive ---------------- */
@media (max-width: 768px) {
  .feed-container {
    padding: 0.5rem;
  }
  
  .feed-card {
    border-radius: 15px;
  }
  
  .carousel-image-container {
    height: 350px;
  }
}
</style>

<div class="feed-container">
  <h2 class="feed-title text-center">Your Feed</h2>

  <% @recipes.each do |recipe| %>
    <div class="card feed-card">
      
      <!-- User Info -->
      <div class="user-info-section">
        <div class="d-flex align-items-center">
          <% if recipe.user.avatar.attached? %>
            <%= link_to user_path(username: recipe.user.username) do %>
              <%= image_tag recipe.user.avatar, class: "rounded-circle me-2 user-avatar" %>
            <% end %>
          <% end %>
          <%= link_to recipe.user.username, user_path(username: recipe.user.username), class: "text-decoration-none username-link" %>
        </div>
      </div>

      <!-- Recipe Title -->
      <div class="recipe-title">
        <%= link_to recipe.title, recipe_path(recipe), class: "text-decoration-none" %>
      </div>

      <!-- Images Carousel -->
      <% if recipe.images.attached? %>
        <div class="carousel-wrapper">
          <div id="carousel-<%= recipe.id %>" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner">
              <% recipe.images.each_with_index do |img, index| %>
                <div class="carousel-item <%= 'active' if index == 0 %>">
                  <%= link_to recipe_path(recipe) do %>
                    <div class="carousel-image-container">
                      <%= image_tag img, class: "carousel-image" %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% if recipe.images.count > 1 %>
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel-<%= recipe.id %>" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carousel-<%= recipe.id %>" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="actions-section">
        <!-- Caption -->
        <% if recipe.caption.present? %>
          <p class="caption"><%= truncate(recipe.caption, length: 120) %></p>
        <% end %>

        <!-- Likes & Bookmarks -->
        <% if current_user %>
          <div class="action-buttons-row">
            <button class="like-btn action-btn <%= recipe.likes.exists?(user: current_user) ? 'btn-outline-danger' : '' %>"
                    data-recipe-id="<%= recipe.id %>">
              <%= recipe.likes.exists?(user: current_user) ? "❤️ Unlike" : "🤍 Like" %>
            </button>
            <span class="count-badge" id="like-count-<%= recipe.id %>"><%= recipe.likes.count %> likes</span>

            <button class="bookmark-btn action-btn <%= current_user.bookmarks.exists?(recipe_id: recipe.id) ? 'btn-outline-warning' : '' %>"
                    data-recipe-id="<%= recipe.id %>">
              <%= current_user.bookmarks.exists?(recipe_id: recipe.id) ? "🔖 Unbookmark" : "📌 Bookmark" %>
            </button>
            <span class="count-badge" id="bookmark-count-<%= recipe.id %>"><%= recipe.bookmarks.count %> bookmarks</span>
          </div>
        <% end %>

        <!-- Comments Button -->
        <div>
          <%= link_to recipe_path(recipe), class: "btn comments-btn w-100 d-flex justify-content-between align-items-center" do %>
            <span>💬 Comments</span>
            <span class="badge comment-badge rounded-pill"><%= recipe.comments.count %></span>
          <% end %>
        </div>

        <!-- Edit / Delete -->
        <% if recipe.user == current_user %>
          <div class="owner-actions">
            <%= link_to "✏️ Edit", edit_recipe_path(recipe), class: "btn edit-btn owner-btn flex-fill" %>
            <%= link_to "🗑️ Delete", recipe_path(recipe), method: :delete, data: { confirm: "Are you sure?" }, class: "btn delete-btn owner-btn flex-fill" %>
          </div>
        <% end %>
      </div>

    </div>
  <% end %>
</div>

<!-- Pagination -->
<div class="pagination-wrapper">
  <%= paginate @recipes, window: 2, outer_window: 1 %>
</div>

<!-- ---------------- Inline JS for AJAX Likes & Bookmarks ---------------- -->
<script>
document.addEventListener("DOMContentLoaded", () => {

  // Handle Likes
  document.querySelectorAll(".like-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const recipeId = btn.dataset.recipeId;
      const liked = btn.innerText.includes("❤️");

      fetch(`/recipes/${recipeId}/like`, {
        method: liked ? "DELETE" : "POST",
        headers: { "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content, "Accept": "application/json" },
        credentials: "same-origin"
      })
      .then(res => res.json())
      .then(data => {
        btn.innerText = data.liked ? "❤️ Unlike" : "🤍 Like";
        btn.className = data.liked ? "like-btn action-btn btn-outline-danger" : "like-btn action-btn";
        document.getElementById(`like-count-${recipeId}`).innerText = `${data.count} likes`;
      });
    });
  });

  // Handle Bookmarks
  document.querySelectorAll(".bookmark-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const recipeId = btn.dataset.recipeId;
      const bookmarked = btn.innerText.includes("🔖");

      fetch(`/recipes/${recipeId}/bookmark`, {
        method: bookmarked ? "DELETE" : "POST",
        headers: { "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content, "Accept": "application/json" },
        credentials: "same-origin"
      })
      .then(res => res.json())
      .then(data => {
        btn.innerText = data.bookmarked ? "🔖 Unbookmark" : "📌 Bookmark";
        btn.className = data.bookmarked ? "bookmark-btn action-btn btn-outline-warning" : "bookmark-btn action-btn";
        document.getElementById(`bookmark-count-${recipeId}`).innerText = `${data.count} bookmarks`;
      });
    });
  });

});
</script>