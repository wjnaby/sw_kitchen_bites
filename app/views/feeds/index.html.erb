<style>
/* ---------------- Feed Card ---------------- */
.feed-card {
  width: 550px;  
  border: 1px solid #ccc; 
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  margin-bottom: 2rem;
  background-color: #fff;
  padding: 1rem;
}

.caption {
  font-style: italic;
  font-size: 1rem;
  color: #222;
  margin-bottom: 1rem;
  text-align: left;
}

/* ---------------- Carousel ---------------- */
.carousel-control-prev,
.carousel-control-next {
  width: 50px;
  height: 50px;
  top: 50%;
  transform: translateY(-50%);
}

.carousel-control-prev {
  left: 15px; 
}

.carousel-control-next {
  right: 15px; 
}

.carousel-control-prev-icon,
.carousel-control-next-icon {
  background-color: rgba(0,0,0,0.5);
  border-radius: 50%;
  width: 50px;
  height: 50px;
}
</style>

<h2 class="mb-4 text-center">Your Feed</h2>

<div class="d-flex flex-column align-items-center gap-4">
  <% @recipes.each do |recipe| %>
    <div class="card feed-card">
      <div class="card-body d-flex flex-column">

        <!-- User Info -->
        <div class="d-flex align-items-center mb-2">
          <% if recipe.user.avatar.attached? %>
            <%= link_to image_tag(recipe.user.avatar, class: "rounded-circle me-2", style: "width:40px;height:40px;object-fit:cover"), user_path(username: recipe.user.username) %>
          <% end %>
          <strong><%= link_to recipe.user.username, user_path(username: recipe.user.username), class: "text-decoration-none text-dark" %></strong>
        </div>

        <!-- Recipe Title -->
        <h5 class="mb-2"><%= link_to recipe.title, recipe_path(recipe), class: "text-decoration-none text-dark" %></h5>

        <!-- Images Carousel -->
        <% if recipe.images.attached? %>
          <div id="carousel-<%= recipe.id %>" class="carousel slide mb-2" data-bs-ride="false">
            <div class="carousel-inner">
              <% recipe.images.each_with_index do |img, index| %>
                <div class="carousel-item <%= 'active' if index == 0 %>">
                  <%= link_to recipe_path(recipe) do %>
                    <div style="width:100%; height:400px; overflow:hidden; border-radius:10px;">
                      <%= image_tag img, class: "d-block w-100 h-100", style: "object-fit: cover; transition: transform 0.5s ease;" %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% if recipe.images.count > 1 %>
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel-<%= recipe.id %>" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carousel-<%= recipe.id %>" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            <% end %>
          </div>
        <% end %>

        <!-- Caption -->
        <% if recipe.caption.present? %>
          <p class="caption"><%= truncate(recipe.caption, length: 120) %></p>
        <% end %>

        <!-- Likes & Bookmarks -->
        <% if current_user %>
          <div class="d-flex gap-2 mb-2 flex-wrap">
            <button class="like-btn btn btn-sm <%= recipe.likes.exists?(user: current_user) ? 'btn-outline-danger' : 'btn-outline-primary' %>"
                    data-recipe-id="<%= recipe.id %>">
              <%= recipe.likes.exists?(user: current_user) ? "❤️ Unlike" : "🤍 Like" %>
            </button>
            <span id="like-count-<%= recipe.id %>"><%= recipe.likes.count %> likes</span>

            <button class="bookmark-btn btn btn-sm <%= current_user.bookmarks.exists?(recipe_id: recipe.id) ? 'btn-outline-warning' : 'btn-outline-secondary' %>"
                    data-recipe-id="<%= recipe.id %>">
              <%= current_user.bookmarks.exists?(recipe_id: recipe.id) ? "🔖 Unbookmark" : "📌 Bookmark" %>
            </button>
            <span id="bookmark-count-<%= recipe.id %>"><%= recipe.bookmarks.count %> bookmarks</span>
          </div>
        <% end %>

        <!-- Comments Button -->
        <div>
          <%= link_to recipe_path(recipe), class: "btn btn-outline-secondary w-100 rounded-pill d-flex justify-content-between align-items-center" do %>
            <span>💬 Comments</span>
            <span class="badge bg-primary rounded-pill"><%= recipe.comments.count %></span>
          <% end %>
        </div>

        <!-- Edit / Delete -->
        <% if recipe.user == current_user %>
          <div class="mt-2 d-flex gap-2">
            <%= link_to "Edit", edit_recipe_path(recipe), class: "btn btn-secondary flex-fill rounded-pill" %>
            <%= link_to "Delete", recipe_path(recipe), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger flex-fill rounded-pill" %>
          </div>
        <% end %>

      </div>
    </div>
  <% end %>
</div>

<!-- Pagination -->
<div class="d-flex justify-content-center mt-4">
  <%= paginate @recipes, window: 2, outer_window: 1 %>
</div>

<!-- ---------------- Inline JS for AJAX Likes & Bookmarks ---------------- -->
<script>
document.addEventListener("DOMContentLoaded", () => {

  // Handle Likes
  document.querySelectorAll(".like-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const recipeId = btn.dataset.recipeId;
      const liked = btn.innerText.includes("❤️");

      fetch(`/recipes/${recipeId}/like`, {
        method: liked ? "DELETE" : "POST",
        headers: { "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content, "Accept": "application/json" },
        credentials: "same-origin"
      })
      .then(res => res.json())
      .then(data => {
        btn.innerText = data.liked ? "❤️ Unlike" : "🤍 Like";
        btn.className = data.liked ? "like-btn btn btn-sm btn-outline-danger" : "like-btn btn btn-sm btn-outline-primary";
        document.getElementById(`like-count-${recipeId}`).innerText = `${data.count} likes`;
      });
    });
  });

  // Handle Bookmarks
  document.querySelectorAll(".bookmark-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const recipeId = btn.dataset.recipeId;
      const bookmarked = btn.innerText.includes("🔖");

      fetch(`/recipes/${recipeId}/bookmark`, {
        method: bookmarked ? "DELETE" : "POST",
        headers: { "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content, "Accept": "application/json" },
        credentials: "same-origin"
      })
      .then(res => res.json())
      .then(data => {
        btn.innerText = data.bookmarked ? "🔖 Unbookmark" : "📌 Bookmark";
        btn.className = data.bookmarked ? "bookmark-btn btn btn-sm btn-outline-warning" : "bookmark-btn btn btn-sm btn-outline-secondary";
        document.getElementById(`bookmark-count-${recipeId}`).innerText = `${data.count} bookmarks`;
      });
    });
  });

});
</script>
