<h2 class="mb-4 text-center">Your Feed</h2>

<div class="d-flex flex-column align-items-center gap-4">
  <% @recipes.each do |recipe| %>
    <div class="card shadow-sm" style="width: 700px; min-height: 500px;">
      <div class="card-body d-flex flex-column">

        <!-- User Info & Follow Button -->
        <div class="d-flex align-items-center mb-3">
          <% if recipe.user.avatar.attached? %>
            <%= link_to image_tag(recipe.user.avatar, class: "rounded-circle me-3", style: "width: 50px; height: 50px; object-fit: cover;"), user_path(username: recipe.user.username) %>
          <% end %>

          <strong class="me-2">
            <%= link_to recipe.user.username, user_path(username: recipe.user.username) %>
          </strong>

          <% if recipe.user != current_user && current_user %>
            <div class="ms-auto">
              <% if current_user.following.exists?(id: recipe.user.id) %>
                <%= button_to "Unfollow", unfollow_user_path(username: recipe.user.username), method: :delete, class: "btn btn-sm btn-danger" %>
              <% else %>
                <%= button_to "Follow", follow_user_path(username: recipe.user.username), method: :post, class: "btn btn-sm btn-primary" %>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Recipe Title & Info -->
        <h4 class="card-title mb-1"><%= link_to recipe.title, recipe_path(recipe) %></h4>
        <p class="mb-2 small">Cooking Time: <%= recipe.cooking_time %> mins</p>
        <p class="mb-3 small"><%= truncate(recipe.instructions, length: 150) %></p>

        <!-- Recipe Images -->
        <% if recipe.images.attached? %>
          <div class="d-flex flex-wrap gap-3 mb-3 justify-content-center">
            <% recipe.images.each do |img| %>
              <div style="width: 200px; height: 200px; overflow: hidden; border-radius: 8px;">
                <%= link_to recipe_path(recipe) do %>
                  <%= image_tag img.variant(resize_to_limit: [200, 200]), class: "img-fluid" %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- Like & Bookmark Buttons -->
        <% if current_user && recipe.user != current_user %>
          <div class="d-flex align-items-center mb-3 gap-3">
            <%# Like button %>
            <% if recipe.likes.exists?(user: current_user) %>
              <%= button_to "❤️ Unlike", recipe_like_path(recipe), method: :delete, class: "btn btn-outline-danger flex-fill" %>
            <% else %>
              <%= button_to "🤍 Like", recipe_like_path(recipe), method: :post, class: "btn btn-outline-primary flex-fill" %>
            <% end %>
            <span class="small"><%= recipe.likes.count %> likes</span>

            <%# Bookmark button %>
            <% if current_user.bookmarks.exists?(recipe_id: recipe.id) %>
              <%= button_to "🔖 Unbookmark", recipe_bookmark_path(recipe), method: :delete, class: "btn btn-outline-warning flex-fill" %>
            <% else %>
              <%= button_to "📌 Bookmark", recipe_bookmark_path(recipe), method: :post, class: "btn btn-outline-secondary flex-fill" %>
            <% end %>
            <span class="small"><%= recipe.bookmarks.count %> bookmarks</span>
          </div>
        <% end %>

        <!-- Comments Button -->
        <div class="mb-3">
          <%= link_to recipe_path(recipe), class: "btn btn-outline-secondary w-100 d-flex justify-content-between align-items-center" do %>
            <span>💬 Comments</span>
            <span class="badge bg-primary rounded-pill"><%= recipe.comments.count %></span>
          <% end %>
        </div>

        <!-- Edit / Delete (owner only) -->
        <% if recipe.user == current_user %>
          <div class="mt-auto d-flex gap-2">
            <%= link_to "Edit", edit_recipe_path(recipe), class: "btn btn-secondary flex-fill" %>
            <%= link_to "Delete", recipe_path(recipe), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger flex-fill" %>
          </div>
        <% end %>

      </div>
    </div>
  <% end %>
</div>
